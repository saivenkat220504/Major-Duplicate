generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  chats     ChatHistory[]
  transits  TransitRecord[]
}

model ChatHistory {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String
  response  String
  createdAt DateTime @default(now())
}

model TransitRecord {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  flightNumber   String
  arrivalTime    DateTime
  departureTime  DateTime
  layoverMinutes Int
  stressLevel    String
  recommendation String
  createdAt      DateTime @default(now())
}

model Flight {
  id            String   @id @default(uuid())
  flightNumber  String   @unique
  arrivalTime   DateTime?
  departureTime DateTime?
  gate          String?
  status        String?
  createdAt     DateTime @default(now())
}

model LuggageGuide {
  id         String @id @default(uuid())
  category   String
  stepNumber Int
  title      String
  description String
  voiceText  String
}

// ── Aura AI Chat History ──────────────────────────────────────────────────────

model AuraChat {
  id        String        @id @default(uuid())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  AuraMessage[]
}

model AuraMessage {
  id        String   @id @default(uuid())
  chat      AuraChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  role      String   // "user" | "assistant"
  content   String
  timestamp DateTime @default(now())
}

// ── Bus Tracking ──────────────────────────────────────────────────────────────
// Stores persistent driver tracking sessions so the backend can decide
// whether a Telegram location request is necessary before notifying the driver.

model BusTracking {
  id                Int       @id @default(autoincrement())
  driverId          String    @unique
  driverName        String
  latitude          Float?
  longitude         Float?
  lastUpdated       DateTime?
  trackingStartedAt DateTime?
  trackingExpiresAt DateTime?
  lastRequestSent   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ── Personal Guardian ──────────────────────────────────────────────────────────

model PersonalGuardian {
  id               String    @id @default(uuid())
  userId           String
  guardianEmail    String
  guardianName     String    @default("")
  guardianVerified Boolean   @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, guardianEmail])
}

model GuardianOtp {
  id        String   @id @default(uuid())
  userId    String
  email     String
  otpHash   String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model GuardianEmailConfig {
  id              String   @id @default(cuid())
  userId          String
  guardianEmail   String
  smtpUser        String
  smtpAppPassword String
  createdAt       DateTime @default(now())

  @@unique([userId, guardianEmail])
}


